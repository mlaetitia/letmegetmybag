# Files and directories to exclude from the published wp.org zip.
# Used by 10up/action-wordpress-plugin-deploy and similar tooling.

# Source / build tooling
/assets/src
/node_modules
/.phpcs.cache

# Repo / dev metadata
/.git
/.github
/.gitignore
/.gitattributes
/.editorconfig
/.distignore
/package.json
/package-lock.json
/composer.json
/composer.lock
/README.md

# OS noise
.DS_Store
Thumbs.db
