{
  "name": "commonplace",
  "version": "0.1.0",
  "description": "Commonplace - a quiet, earthy editorial block theme for the multipotentialite. Forked from Twenty Twenty-Five.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "author": "Lae",
  "homepage": "https://letmegetmybag.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlaetitia/letmegetmybag.git",
    "directory": "wp-content/themes/commonplace"
  },
  "scripts": {
    "build": "postcss style.css --use cssnano -o style.min.css --no-map",
    "watch": "postcss style.css --use cssnano -o style.min.css --no-map --watch",
    "start": "npm run watch",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{css,html,json}\""
  },
  "devDependencies": {
    "@wordpress/browserslist-config": "^6.34.0",
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ]
}
