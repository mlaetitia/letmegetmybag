{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "640px",
			"wideSize": "1100px"
		},
		"color": {
			"defaultPalette": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"color": "#FAF7F2",
					"name": "Cream"
				},
				{
					"slug": "contrast",
					"color": "#1F1B2E",
					"name": "Deep Ink"
				},
				{
					"slug": "accent",
					"color": "#5B3A5A",
					"name": "Plum"
				},
				{
					"slug": "accent-sage",
					"color": "#8FA888",
					"name": "Sage"
				},
				{
					"slug": "accent-terracotta",
					"color": "#C67B5C",
					"name": "Terracotta"
				},
				{
					"slug": "accent-ochre",
					"color": "#C9A24A",
					"name": "Ochre"
				},
				{
					"slug": "subtle",
					"color": "#EFEAE0",
					"name": "Subtle"
				},
				{
					"slug": "muted",
					"color": "#6E6A78",
					"name": "Muted Ink"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Fraunces\", \"EB Garamond\", Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Large",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"size": "1.75rem",
					"name": "Extra Large",
					"fluid": {
						"min": "1.5rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "2.5rem",
					"name": "Display",
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					}
				}
			]
		},
		"spacing": {
			"units": ["%", "px", "em", "rem", "vh", "vw"],
			"spacingScale": {
				"theme": false
			},
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "1"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "2"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "3"
				},
				{
					"slug": "50",
					"size": "2rem",
					"name": "4"
				},
				{
					"slug": "60",
					"size": "3rem",
					"name": "5"
				},
				{
					"slug": "70",
					"size": "4.5rem",
					"name": "6"
				},
				{
					"slug": "80",
					"size": "6rem",
					"name": "7"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline wavy"
					}
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "500",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "500",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "500",
					"lineHeight": "1.3"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--accent)",
					"style": "solid",
					"width": "0 0 0 3px"
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontStyle": "italic"
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--accent)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": []
}
