{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "640px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"name": "Cream (Stone)",
					"color": "#EEEBE3"
				},
				{
					"slug": "base-deep",
					"name": "Cream Deep",
					"color": "#F4EFE5"
				},
				{
					"slug": "base-dim",
					"name": "Slate (dim mode)",
					"color": "#2A3340"
				},
				{
					"slug": "contrast",
					"name": "Ink",
					"color": "#1F1B2E"
				},
				{
					"slug": "contrast-dim",
					"name": "Ink (dim mode)",
					"color": "#EEE8DA"
				},
				{
					"slug": "ink-soft",
					"name": "Ink Soft",
					"color": "#4A4558"
				},
				{
					"slug": "ink-muted",
					"name": "Ink Muted",
					"color": "#7A7585"
				},
				{
					"slug": "rule",
					"name": "Rule",
					"color": "rgba(31,27,46,0.14)"
				},
				{
					"slug": "rule-soft",
					"name": "Rule Soft",
					"color": "rgba(31,27,46,0.08)"
				},
				{
					"slug": "accent",
					"name": "Accent (current section)",
					"color": "#8A2E7D"
				},
				{
					"slug": "notes",
					"name": "Notes (Plum)",
					"color": "#8A2E7D"
				},
				{
					"slug": "reading",
					"name": "Reading (Teal)",
					"color": "#1E8A9E"
				},
				{
					"slug": "making",
					"name": "Making (Terracotta)",
					"color": "#E84E1C"
				},
				{
					"slug": "coding",
					"name": "Coding (Ochre)",
					"color": "#F2A50C"
				},
				{
					"slug": "growing",
					"name": "Growing (Sage)",
					"color": "#4E9A3F"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": ["%", "px", "em", "rem", "vh", "vw"],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "1 (8px)",
					"size": "8px"
				},
				{
					"slug": "30",
					"name": "2 (16px)",
					"size": "16px"
				},
				{
					"slug": "40",
					"name": "3 (mobile gutter)",
					"size": "22px"
				},
				{
					"slug": "50",
					"name": "4 (fluid)",
					"size": "clamp(22px, 4vw, 40px)"
				},
				{
					"slug": "60",
					"name": "5 (desktop gutter)",
					"size": "clamp(40px, 5vw, 56px)"
				},
				{
					"slug": "70",
					"name": "6 (fluid large)",
					"size": "clamp(56px, 8vw, 96px)"
				},
				{
					"slug": "80",
					"name": "7 (sections)",
					"size": "clamp(80px, 10vw, 144px)"
				}
			]
		},
		"typography": {
			"fluid": true,
			"writingMode": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Serif (EB Garamond)",
					"fontFamily": "\"EB Garamond\", \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"src": ["file:./assets/fonts/eb-garamond/EBGaramond-VariableFont_wght.woff2"],
							"fontWeight": "400 800",
							"fontStyle": "normal",
							"fontFamily": "EB Garamond",
							"fontDisplay": "swap"
						},
						{
							"src": ["file:./assets/fonts/eb-garamond/EBGaramond-Italic-VariableFont_wght.woff2"],
							"fontWeight": "400 800",
							"fontStyle": "italic",
							"fontFamily": "EB Garamond",
							"fontDisplay": "swap"
						}
					]
				},
				{
					"slug": "sans",
					"name": "Sans (Manrope)",
					"fontFamily": "Manrope, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif",
					"fontFace": [
						{
							"src": ["file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2"],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Manrope",
							"fontDisplay": "swap"
						}
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "1.875rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Headline",
					"size": "2.875rem",
					"fluid": {
						"min": "2.5rem",
						"max": "2.875rem"
					}
				}
			]
		}
	},
	"styles": {
		"css": "html { font-feature-settings: \"ss01\", \"ss02\", \"cv11\"; }",
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "500",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			},
			"blockGap": "1.2rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "400",
					"lineHeight": "1.05",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "400",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "500",
					"lineHeight": "1.25"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "500",
					"lineHeight": "1.3"
				}
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "400",
					"lineHeight": "1.05",
					"letterSpacing": "-0.02em"
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--accent)",
					"style": "solid",
					"width": "0 0 0 3px"
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)",
						"top": "var(--wp--preset--spacing--20)",
						"bottom": "var(--wp--preset--spacing--20)",
						"right": "0"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontStyle": "italic",
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.4"
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--rule)"
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--base-deep)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontStyle": "italic",
					"fontSize": "1.0625rem",
					"fontWeight": "400",
					"letterSpacing": "-0.01em"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": []
}
