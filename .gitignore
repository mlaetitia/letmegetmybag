# =============================================================================
# letmegetmybag - allowlist .gitignore
# =============================================================================
# Strategy: ignore everything by default, then explicitly allow our own code.
# When you create a new theme, plugin, or mu-plugin, add a corresponding
# allowlist entry below.
# =============================================================================

# --- Repo root: ignore everything by default --------------------------------
/*

# --- Re-include repo-level scaffolding --------------------------------------
!/.editorconfig
!/.gitattributes
!/.github
!/.gitignore
!/LICENSE
!/README.md
!/composer.json
!/composer.lock
!/package.json
!/package-lock.json
!/phpcs.xml.dist
!/wp-content

# --- wp-content: ignore everything by default -------------------------------
/wp-content/*

# --- Re-include directories that may host our custom code -------------------
!/wp-content/themes
!/wp-content/plugins
!/wp-content/mu-plugins

# --- Inside themes/plugins/mu-plugins: ignore everything --------------------
# (this excludes WordPress defaults, third-party themes/plugins, etc.)
/wp-content/themes/*
/wp-content/plugins/*
/wp-content/mu-plugins/*

# =============================================================================
# Allowlist: our custom code
# Add a new line here whenever you create a new theme, plugin, or mu-plugin.
# =============================================================================
!/wp-content/themes/commonplace
# !/wp-content/plugins/<your-plugin-slug>
# !/wp-content/mu-plugins/<your-mu-plugin-slug>

# --- Build / dependency directories inside our custom code ------------------
/wp-content/themes/*/node_modules
/wp-content/themes/*/vendor
/wp-content/themes/*/.phpcs.cache
/wp-content/plugins/*/node_modules
/wp-content/plugins/*/vendor
/wp-content/plugins/*/.phpcs.cache
/wp-content/mu-plugins/*/node_modules
/wp-content/mu-plugins/*/vendor
/wp-content/mu-plugins/*/.phpcs.cache

# --- Repo-root build / cache artifacts --------------------------------------
/node_modules
/vendor
/.phpcs.cache
/.phpunit.result.cache

# --- OS noise ---------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Editor noise -----------------------------------------------------------
/.idea
/.vscode
*.swp
*.swo
*~
