<?xml version="1.0"?>
<ruleset name="letmegetmybag">
	<description>PHP_CodeSniffer configuration for custom WordPress code in this repo.</description>

	<!-- Scan only our custom code, not WordPress core or third-party themes/plugins. -->
	<file>wp-content/themes/commonplace</file>
	<!-- Add new paths as you create custom plugins / mu-plugins:
	<file>wp-content/plugins/your-slug</file>
	<file>wp-content/mu-plugins/your-slug</file>
	-->

	<!-- Show progress and sniff codes. -->
	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>

	<!-- Exclude generated and dependency files. -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>

	<!-- WordPress Coding Standards. -->
	<rule ref="WordPress">
		<!-- Allow short array syntax (PHP 5.4+). -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- WordPress version compatibility. Bump as you set a higher minimum. -->
	<config name="minimum_supported_wp_version" value="6.5"/>

	<!-- PHP version compatibility. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.0-"/>

	<!-- Per-theme/plugin text-domain enforcement is handled inside each
	     workspace; the root config doesn't pin a single text domain. -->
</ruleset>
